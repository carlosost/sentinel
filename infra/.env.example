# Sentinel — local infra credentials (infra/docker-compose.yml + infra/litellm_config.yaml)
#
# Setup:
#   cp infra/.env.example infra/.env
#   # then edit infra/.env and replace every REPLACE_ME_* value with a real key
#
# infra/.env is gitignored (see .gitignore) — never commit real keys.
#
# `make check-env` validates this file before any target that talks to the
# real LiteLLM proxy (`make up` / `make smoke` / `make test` / `make shell`),
# and fails loudly listing exactly which credential(s) are missing or still a
# placeholder, instead of letting the failure surface three layers deep
# inside the litellm container's logs.

# --- LLM provider keys -----------------------------------------------------
# Read directly by the `litellm` proxy container (infra/litellm_config.yaml's
# model_list) — LiteLLM auto-detects these by name from its process
# environment. Each comment lists the model aliases the key backs.

# openai/gpt-4o, openai/gpt-4o-mini, openai/text-embedding-3-small,
# openai/omni-moderation-latest — backs sentinel-router, sentinel-grader,
# sentinel-diagnose, sentinel-propose-action, sentinel-postmortem,
# sentinel-judge, sentinel-embedding, and sentinel-guardrail-fallback.
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY

# --- Retired (ADR-023, Feature 15, Phase 2) --------------------------------
# ANTHROPIC_API_KEY and COHERE_API_KEY used to back every *-fallback alias
# except sentinel-guardrail-fallback (Anthropic) and sentinel-embedding-fallback
# (Cohere). As of ADR-023, those fallback slots resolve to local Ollama-served
# models (infra/litellm_config.yaml + infra/docker-compose.yml's `ollama`
# service) and no longer require either key. Left commented out, with this
# dated note, rather than deleted — see MIGRATION_PLAN.md and
# PROJECT_MEMORY.md's ADR-023 for the full decision record.
#
# Cutover confirmed complete at Phase 4.5 (2026-06-28): both keys have been
# revoked at the provider dashboards. These two lines are historical record
# only, not a live rollback path — restoring local-fallback behavior to paid
# APIs would require provisioning brand-new keys, not uncommenting these.
# ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
# COHERE_API_KEY=REPLACE_ME_COHERE_API_KEY
#
# TOGETHERAI_API_KEY retired (ADR-023 Phase 5, 2026-07-06): sentinel-guardrail's
# primary migrated from together_ai/meta-llama/Meta-Llama-Guard-3-8B to
# ollama_chat/llama-guard3:8b — no API key required. Pull the model with
# `make pull-local-models` before first use.
# TOGETHERAI_API_KEY=REPLACE_ME_TOGETHERAI_API_KEY

# --- Sentinel app config ---------------------------------------------------
# These are NOT provider API keys — they are configuration variables consumed
# by host-side scripts (make ingest, make eval, make smoke) and the app
# container. All are checked by `make check-env`.

# URL of the running LiteLLM proxy. Host-side value is http://localhost:4000
# (the port mapped by infra/docker-compose.yml). Inside Docker the app service
# uses http://litellm:4000 (set automatically by docker-compose.yml) — this
# value is only used when running scripts directly on the host.
LITELLM_PROXY_URL=http://localhost:4000

# LangSmith API key — enables tracing in src/observability/tracing.py and
# `make eval` LangSmith evaluator calls. Get one at https://smith.langchain.com.
LANGCHAIN_API_KEY=REPLACE_ME_LANGCHAIN_API_KEY

# LangSmith project name (optional — defaults to "sentinel" if unset).
LANGCHAIN_PROJECT=sentinel

# Ollama base URL. Host-side value is http://localhost:11434.
# The litellm container uses http://ollama:11434 (set automatically by
# docker-compose.yml) — this value is used when host scripts call Ollama directly.
OLLAMA_BASE_URL=http://localhost:11434

# Per-caller virtual key issued by the LiteLLM proxy (ADR-018: sentinel-app /
# sentinel-eval / sentinel-dev — see infra/litellm_config.yaml's
# general_settings.virtual_keys). Optional for local dev — client_factory.py
# works without it — required for anything resembling production use.
# Not checked by `make check-env` (intentionally not a hard requirement).
LITELLM_VIRTUAL_KEY=REPLACE_ME_LITELLM_VIRTUAL_KEY

# Hugging Face token — optional. Suppresses "unauthenticated requests" rate-limit
# warnings from sentence-transformers (bge-reranker-base, bge-small-en-v1.5).
# Get one (read-only scope) at https://huggingface.co/settings/tokens.
# Not checked by `make check-env`.
HF_TOKEN=
